{
  "name": "recipe-organizer-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test:client && npm run test:server",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:watch": "concurrently \"npm run test:watch --workspace=client\" \"npm run test:watch --workspace=server\"",
    "test:coverage": "npm run test:coverage --workspace=client && npm run test:coverage --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
